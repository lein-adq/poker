# ==============================================================================
# ENV CONFIGURATION FOR PRODUCTION / REAL USAGE
# ==============================================================================

# ------------------------------------------------------------------------------
# Email Sending (Ory Kratos Courier)
# ------------------------------------------------------------------------------
# To use a real email like Gmail for sending registration codes:
# 1. Get an App Password from your Google Account
# 2. Uncomment the line below and replace tu_correo and TU_APP_PASSWORD
# 3. Kratos will automatically use this instead of the local MailSlurper
#
COURIER_SMTP_CONNECTION_URI=smtps://[EMAIL_ADDRESS]:[PASSWORD]@smtp.gmail.com:465/?skip_ssl_verify=false
